from collections import deque

capacity1 = 11
capacity2 = 9
target = 8

queue = deque()
queue.append((0, 0, []))

visited = set()
visited.add((0, 0))

while queue:

    a, b, path = queue.popleft()

    if a == target or b == target:
        print("Goal Reached!")
        print("Number of moves:", len(path))

        for i, move in enumerate(path, 1):
            print(i, move)

        print("Final State:", (a, b))
        break

    states = []

    states.append((11, b, "Fill 11L jug"))

    states.append((a, 9, "Fill 9L jug"))

    states.append((0, b, "Empty 11L jug"))

    states.append((a, 0, "Empty 9L jug"))

    amount = min(a, 9 - b)
    states.append((a - amount, b + amount,
                   "Pour 11L into 9L"))

    amount = min(b, 11 - a)
    states.append((a + amount, b - amount,
                   "Pour 9L into 11L"))

    for x, y, action in states:

        if (x, y) not in visited:
            visited.add((x, y))
            queue.append((x, y, path + [action]))
